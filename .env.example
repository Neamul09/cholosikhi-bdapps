# Supabase configuration — get these from your project's Settings → API page.
# https://app.supabase.com/project/_/settings/api
#
# IMPORTANT: never commit real values. Copy this file to `.env.local` (which is
# gitignored) and fill in your own credentials. Rotating a leaked key is done
# via Settings → API → "Rotate anon key" in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Tutor Provider Credentials (Optional — multi-tier fallback cascade enabled)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
# GROQ_API_KEY=your-groq-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Discord invite link — used by Community Hub CTAs and the landing page.
# Replace with your real invite (Discord → Server Settings → Invites → Create).
# The default is a placeholder; pages detect this and render a "Coming soon"
# hint instead of sending the user to a 404.
VITE_DISCORD_URL=https://discord.gg/cholosikhi-placeholder

# Contact email — used by the landing page mailto button.
VITE_CONTACT_EMAIL=contact@cholosikhi.com
